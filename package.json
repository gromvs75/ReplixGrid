{
  "name": "replixgrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:kernel": "esbuild src/worker.ts --bundle --format=esm --platform=browser --outfile=public/kernel/worker.js --external:node:* && node --input-type=module -e \"import {copyFileSync} from 'node:fs'; copyFileSync('node_modules/manifold-3d/manifold.wasm','public/kernel/manifold.wasm')\"",
    "samples": "node --import tsx tests/samples.ts",
    "dev": "npm run build:kernel && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && npm run build:kernel && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "manifold-3d": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
